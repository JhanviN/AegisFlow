# AegisFlow environment configuration
# Copy to .env and fill in values before running docker compose

# OpenAI API credentials (required for production)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: override OpenAI base URL for Azure or mock servers
OPENAI_BASE_URL=https://api.openai.com/v1

# Comma-separated list of valid API keys for gateway authentication
API_KEYS=dev-api-key-1,dev-api-key-2

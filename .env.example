# AegisFlow environment configuration
# Copy to .env and fill in values before running docker compose

# OpenAI API credentials (leave as placeholder to auto-enable mock mode)
OPENAI_API_KEY=sk-your-openai-api-key

# Force mock mode even when a real key is set (optional)
MOCK_LLM_MODE=true

# Simulated LLM latency in ms (set to 0 for load tests)
MOCK_LLM_DELAY_MS=25

# PII masking: ml (Presidio+NER) or regex (fast path for benchmarks)
PII_MASK_MODE=ml

# Requests per minute per API key (6000 = ~100/sec; use 360000 for load tests)
RATE_LIMIT_RPM=6000

# Optional: override OpenAI base URL for Azure OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1

# Comma-separated list of valid API keys for gateway authentication
API_KEYS=dev-api-key-1,dev-api-key-2

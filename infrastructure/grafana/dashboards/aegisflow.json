  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aegisflow_http_request_duration_seconds_bucket{route=\"/v1/chat/completions\"}[5m])) by (le))",
          "legendFormat": "p95 Gateway Overhead"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aegisflow_http_request_duration_seconds_bucket{route=\"/v1/chat/completions\"}[5m])) by (le))",
          "legendFormat": "p99 Gateway Overhead"
        }
      ],
      "title": "Gateway Endpoint Latency (p95 / p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(aegisflow_http_requests_total[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ],
      "title": "Request Rate by Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "rate(aegisflow_redis_cache_hits_total[5m]) / (rate(aegisflow_redis_cache_hits_total[5m]) + rate(aegisflow_redis_cache_misses_total[5m]))",
          "legendFormat": "Hit Rate"
        },
        {
          "expr": "rate(aegisflow_redis_cache_misses_total[5m]) / (rate(aegisflow_redis_cache_hits_total[5m]) + rate(aegisflow_redis_cache_misses_total[5m]))",
          "legendFormat": "Miss Rate"
        }
      ],
      "title": "Redis Cache Hit / Miss Rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "redis_evicted_keys_total",
          "legendFormat": "Evicted Keys"
        },
        {
          "expr": "redis_keyspace_keys",
          "legendFormat": "Total Keys"
        }
      ],
      "title": "Redis Eviction & Key Count",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
